# Frontend (Vite) — copy to .env for local dev
# App is served at https://connect.aptahire.ai/recruiters/
VITE_LEAD_API_URL=https://connect.aptahire.ai/recruiters/api/lead.php
VITE_BOOKING_REDIRECT_URL=https://cal.com/rakeshr7/strategy-call

# Backend SMTP (used by api/test-mail.php and can be read by PHP)
# Equivalent to:
# swaks --to ... --from info@aptahire.io --server mail.deepsense.co.in --port 587 --auth LOGIN --auth-user info@aptahire.io --auth-password '$MAIL_PASS' --tls
MAIL_PASS=your-smtp-password-here

# Backend (PHP) — optional overrides in api/config.php on server
# Defaults: to sriethiraj@getnos.io, from info@aptahire.io
